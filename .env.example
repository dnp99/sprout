# Neon Postgres — pooled connection (used by the app at runtime).
# Get these from the Neon dashboard → Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/sprout?sslmode=require"

# Neon Postgres — direct/unpooled connection (used for migrations only).
# Neon's pooler runs PgBouncer in transaction mode and does not reliably apply
# DDL, so drizzle-kit migrations use this direct URL instead.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/sprout?sslmode=require"

# Neon Postgres connection strings. Copy this file to .env.local and paste your
# real values (from the Neon dashboard → Connection Details).
#
# Neon branch per environment:
#   - Local dev (.env.local)      -> the `develop` (preview) branch
#   - Vercel Preview env vars     -> `develop` (or a per-PR branch)
#   - Vercel Production env vars  -> the `main` branch
#
# Locally we only ever migrate/seed the develop branch — never prod. Neon `main`
# gets the schema when Vercel runs a production deploy (scripts/migrate-on-deploy.mjs).

# Pooled connection (host has "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct/unpooled connection (no "-pooler") — used for migrations only. Neon's
# pooler runs PgBouncer in transaction mode and does not reliably apply DDL, so
# drizzle-kit migrations use this direct URL instead.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional. Enables AI categorization for CSV import (Claude claude-haiku-4-5).
# Without it, imports still work — unmatched merchants just import uncategorized.
# See docs/csv-import.md.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional. Enables the onboarding analytics funnel (PostHog). Without the key,
# analytics is a complete no-op — nothing loads and nothing is sent. Privacy
# stance + the events we send are documented in docs/analytics.md.
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# Defaults to PostHog US cloud if unset; set to your region/self-hosted host.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- External capture: WhatsApp via Twilio (plan 008) ---
# Required to verify the WhatsApp webhook. From Twilio Console → Account Info.
# Without it, /api/webhooks/whatsapp rejects every request (fail closed).
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# Optional. Force the exact URL Twilio signs (useful behind an ngrok tunnel where
# forwarded headers can't be trusted), e.g. https://abc123.ngrok.io/api/webhooks/whatsapp
TWILIO_WEBHOOK_URL=""
# Optional. The Sprout WhatsApp number shown in the in-app link instructions
# (Twilio sandbox default is +1 415 523 8886).
NEXT_PUBLIC_WHATSAPP_NUMBER="+14155238886"
# Optional. App origin used for deep links in WhatsApp "edit" replies.
NEXT_PUBLIC_APP_URL="https://sprout-money.ca"
